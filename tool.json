{
  "id": "demo",
  "version": "0.1.0",
  "name": "Demo",
  "description": "Template smoke tool for verifying scaffold",
  "icon": "tool",
  "category": "test",
  "author": {
    "name": "visual-e2e"
  },
  "rpc": {
    "protocolVersion": 2
  },
  "capabilities": [
    "project.context",
    "project.list",
    "project.variables",
    "config.settings",
    "config.browserRuntime",
    "fs.pickFolder",
    "fs.dataDir",
    "scenario.navigate",
    "cache.clear"
  ],
  "ports": {
    "preferredProd": 7209,
    "prod": 7209,
    "dev": 7109,
    "webDev": 7159
  },
  "main": "server/dist/index.js",
  "webRoot": "web/dist",
  "engines": {
    "host": ">=1.4.0"
  },
  "sandbox": {
    "allow": [
      "scripts",
      "forms",
      "popups",
      "same-origin"
    ],
    "bridge": []
  }
}
